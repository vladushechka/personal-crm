# Local PostgreSQL (docker-compose.yml). Copy this file to .env and fill in the values.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Connection string for the app: postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL=

# Sign-in (Better Auth). Secret: 32+ random characters, e.g.
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
BETTER_AUTH_SECRET=
# Address of the site: http://localhost:3000 locally, https://app.vladmath.com on the server
BETTER_AUTH_URL=
# Where emails go: smtp://127.0.0.1:1025 (Mailpit) locally, smtps://resend:API_KEY@smtp.resend.com:465 on the server
SMTP_URL=
# Sender of the sign-in email
MAIL_FROM="Personal CRM <noreply@mail.app.vladmath.com>"
# Owner of the contacts that existed before sign-in, and of the demo data
OWNER_EMAIL=
